--- !u!114 &2059348522
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2059348520}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dans un futur o\xF9 l\u2019humanit\xE9 a enfin d\xE9couvert comment voyager
    \xE0 travers l\u2019espace, les compagnies interstellaires sont devenues essentielles.
    Parmi elles, SpaceEat, une entreprise sp\xE9cialis\xE9e dans le transport de
    nourriture entre les plan\xE8tes, domine le march\xE9.\n\nVous incarnez un astronaute
    travaillant pour SpaceEat, charg\xE9 d\u2019effectuer une livraison de routine
    \xE0 travers la galaxie. Tout semblait se d\xE9rouler normalement\u2026 jusqu\u2019\xE0
    ce qu\u2019un gigantesque ast\xE9ro\xEFde percute votre vaisseau.\n\nL\u2019impact
    d\xE9truit une partie des syst\xE8mes principaux et plonge le vaisseau dans le
    chaos. Les alarmes retentissent, l\u2019alimentation devient instable et plusieurs
    sections sont d\xE9sormais hors de contr\xF4le. Perdu au milieu du vide spatial,
    sans aucun contact avec l\u2019ext\xE9rieur, votre seule chance de survie est
    de r\xE9parer le vaisseau avant qu\u2019il ne soit trop tard.\n\nTraversez les
    diff\xE9rentes zones endommag\xE9es, \xE9vitez les dangers qui se cachent dans
    les couloirs et r\xE9activez les syst\xE8mes essentiels pour tenter de survivre
    dans l\u2019immensit\xE9 glaciale de l\u2019espace."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 79459efec17a4d00a321bdcc27bbc385, type: 2}
